{
  "_comment": "PRODUCTION CONFIG TEMPLATE. Do not put real secrets in this file — it is source-controlled. Set every value below via environment variables (or your host's secret manager) using the ASP.NET Core convention: Section__Key, e.g. ConnectionStrings__DefaultConnection, Jwt__Secret, ExternalServices__PaymentGateway__KeySecret. This file only documents which keys production needs.",

  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_VIA_ENV_VAR__Host=your-db-host;Port=5432;Database=loveat;Username=loveat_app;Password=REPLACE;SSL Mode=Require;Trust Server Certificate=true"
  },

  "Jwt": {
    "Secret": "REPLACE_VIA_ENV_VAR__must_be_at_least_32_random_bytes",
    "Issuer": "LovEat.API",
    "Audience": "LovEat.Clients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },

  "Cors": {
    "AllowedOrigins": [
      "https://app.loveat.example",
      "https://chef.loveat.example",
      "https://admin.loveat.example"
    ]
  },

  "ExternalServices": {
    "PaymentGateway": {
      "Provider": "Razorpay",
      "KeyId": "REPLACE_VIA_ENV_VAR",
      "KeySecret": "REPLACE_VIA_ENV_VAR",
      "WebhookSecret": "REPLACE_VIA_ENV_VAR"
    },
    "Sms": {
      "Provider": "MSG91",
      "ApiKey": "REPLACE_VIA_ENV_VAR",
      "SenderId": "LOVEAT"
    },
    "Push": {
      "Provider": "FCM",
      "ProjectId": "REPLACE_VIA_ENV_VAR",
      "ServiceAccountJson": "REPLACE_VIA_ENV_VAR__full_service_account_json_as_a_single_line_string"
    },
    "Storage": {
      "Provider": "S3",
      "BucketName": "REPLACE_VIA_ENV_VAR",
      "AccessKey": "REPLACE_VIA_ENV_VAR",
      "SecretKey": "REPLACE_VIA_ENV_VAR",
      "Region": "ap-south-1",
      "PublicBaseUrl": "https://REPLACE.s3.ap-south-1.amazonaws.com"
    },
    "Maps": {
      "Provider": "GoogleMaps",
      "ApiKey": "REPLACE_VIA_ENV_VAR"
    },
    "Streaming": {
      "Provider": "Mux",
      "MuxTokenId": "REPLACE_VIA_ENV_VAR",
      "MuxTokenSecret": "REPLACE_VIA_ENV_VAR"
    }
  },

  "Redis": {
    "Enabled": true,
    "ConnectionString": "REPLACE_VIA_ENV_VAR__your-redis-host:6379,password=REPLACE"
  },

  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimitPerMinute": 120
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "WriteToFile": true,
    "LogDirectory": "/var/log/loveat-api"
  },

  "AllowedHosts": "api.loveat.example"
}
